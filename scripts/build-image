#!/usr/bin/env bash
# Builds the Nomenclator container image for the local architecture (native builds only: no cross-compiling).
# sbt-native-packager builds the native-image binary in docker/toolchain's image and stages the image's Dockerfile
# (app/target/docker/stage), then this runs docker buildx over that stage.
# Needs Docker with buildx and about 7 GB of free memory for native-image (its builder peaked at 6.75 GB RSS on
# arm64). Full output goes to target/build-image.log.
set -euo pipefail

usage() {
  cat <<USAGE
Usage: scripts/build-image [--tag <ref>]

Builds the image for the local architecture and loads it into the local Docker daemon.

  --tag <ref>   image reference to build (default: nomenclator:local)
  -h, --help    show this help
USAGE
}

tag="nomenclator:local"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tag)
      [[ $# -ge 2 ]] || { echo "--tag needs a value" >&2; usage >&2; exit 2; }
      tag="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

cd "$(dirname "$0")/.."
mkdir -p target
log="target/build-image.log"
context="app/target/docker/stage"
native_lib="app/target/graalvm-native-image/stage/lib"

fail() {
  echo "build-image FAILED: $1; full log: $PWD/$log" >&2
  exit 1
}

started=$SECONDS
: > "$log"

sbt -batch app/Docker/stage >> "$log" 2>&1 || fail "sbt app/Docker/stage"

# native-packager takes the dependency jars from packagedArtifacts, which NoPublishPlugin empties unless a project
# turns packageBin's publishArtifact back on (see core in build.sbt). A binary built without nomenclator-core still
# builds, then dies at startup with NoClassDefFoundError, so check the jar made it in.
compgen -G "$native_lib/*nomenclator-core*.jar" > /dev/null \
  || fail "$native_lib holds no nomenclator-core jar, so the binary would lack its classes (is Compile / packageBin / publishArtifact true on core?)"

docker buildx build --load --progress=plain --tag "$tag" \
  --file "$context/Dockerfile" "$context" >> "$log" 2>&1 \
  || fail "docker buildx build"

# Read the binary's size from the finished image, since a cached build leaves no native-image report in the log.
cid="$(docker create "$tag")"
trap 'docker rm "$cid" >/dev/null' EXIT
binary_bytes="$(docker export "$cid" | tar -xOf - app/nomenclator | wc -c)"

echo "image:   $tag ($(docker image inspect --format '{{.Id}}' "$tag"))"
echo "size:    $(docker image inspect --format '{{.Size}}' "$tag" | awk '{printf "%.1f MB", $1/1000000}')"
echo "binary:  $(awk -v b="$binary_bytes" 'BEGIN {printf "%.1f MB", b/1000000}')"
echo "elapsed: $((SECONDS - started)) s"
echo "log:     $PWD/$log"
